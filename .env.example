# Environment: development or production
ENV=development

# Public base URL of the gateway/dashboard
PUBLIC_URL=http://localhost:3000

# 32 random bytes, base64-encoded. Used to encrypt stored provider credentials and secrets.
# Generate with: openssl rand -base64 32
GATEWAY_MASTER_KEY=

# Database connection (PostgreSQL 18+, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway
POSTGRES_PASSWORD=postgres

# Redis connection (Redis 8+, with password)
REDIS_URL=redis://:redispassword@localhost:6379/0
REDIS_PASSWORD=redispassword

# Logging level: debug, info, warning, error
LOG_LEVEL=info

# Maximum request body size in bytes (default 4MB)
MAX_REQUEST_BYTES=4194304

# Default retention days for logs and content (default 30)
DEFAULT_RETENTION_DAYS=30

# Allow private/loopback URLs for openai_compatible providers (set true only for local models)
ALLOW_PRIVATE_PROVIDER_URLS=false

# Demo mode (populates sample projects and history on first start, uses mock provider)
DEMO_MODE=true

# Domain for Caddy TLS in production
DOMAIN=localhost
